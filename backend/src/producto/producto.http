### GET all productos
http://localhost:3000/api/producto

### ID
@id = {{createProducto.response.body.data.id}}

### GET one producto
http://localhost:3000/api/producto/{{id}}

### POST a producto comida
# @name createProducto
POST http://localhost:3000/api/producto
Content-Type: application/json

{
    "nombre": "lemon pie",
    "categoria": "<id_categoria_comidas>",
    "descripcion": "Tarta con base de galleta y relleno de crema de limón",
    "precio": 3500
}

### POST a producto bebida
POST http://localhost:3000/api/producto
Content-Type: application/json

{
    "nombre": "cafe cortado",
    "categoria": "<id_categoria_bebidas>",
    "descripcion": "Café con leche vaporizada en menor cantidad que el café latte",
    "precio": 3000
}

### PUT a producto
PUT http://localhost:3000/api/producto/{{id}}
Content-Type: application/json

{
  "nombre": "cafe cortado",
  "categoria": "<id_categoria_bebidas>",
  "descripcion": "Café con leche vaporizada en menor cantidad que el café latte",
  "precio": 3000
}

### PATCH a producto
PATCH http://localhost:3000/api/producto/{{id}}
Content-Type: application/json

{
  "nombre": "lemon pie"
}

### DELETE a producto
@id = {{createProducto.response.body.data.id}}
DELETE http://localhost:3000/api/producto/{{id}}

