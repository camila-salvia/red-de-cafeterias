### 1. Crear el primer Administrador
POST http://localhost:3000/api/usuario
Content-Type: application/json

{
    "nombre": "Admin",
    "apellido": "Principal",
    "telefono": "123456789",
    "direccion": "Cafeteria",
    "email": "admin@cafeteria.com",
    "password": "password123",
    "esAdmin": true
}

### 2. Iniciar sesión y capturar el Token
# @name loginAdmin
POST http://localhost:3000/api/usuario/login
Content-Type: application/json

{
  "email": "admin@cafeteria.com",
  "password": "password123"
}

### Guardamos el token devuelto en una variable global
@token = {{loginAdmin.response.body.data.token}}

### 3. GET all usuarios (¡Ahora sí tienes permiso!)
GET http://localhost:3000/api/usuario
Authorization: Bearer {{token}}

### GET all usuarios
http://localhost:3000/api/usuario

### ID
@id = {{createUsuario.response.body.data.id}}

### GET one usuario
http://localhost:3000/api/usuario/{{id}}


### POST a usuario
# @name createUsuario
POST http://localhost:3000/api/usuario
Content-Type: application/json

{
    "nombre": "Camila",
    "apellido": "Salvia",
    "telefono": "654456780",
    "direccion": "Calle Falsa 1234",
    "email": "cami@example.com",
    "password": "password000",
    "esAdmin": true
}

### PUT a usuario
PUT http://localhost:3000/api/usuario/25b6e2e5-dbe8-4089-9f8e-4e9a12b7611e
Content-Type: application/json

{
    "nombre": "Camila",
    "apellido": "Salvia",
    "telefono": "123456789",
    "direccion": "Calle Falsa 123",
    "email": "camila.salvia@example.com",
    "password": "password123",
    "esAdmin": false
}


### PATCH a usuario
PATCH http://localhost:3000/api/usuario/{{id}}
Content-Type: application/json

{
    "esAdmin": true
}

### DELETE a usuario
@id = {{createUsuario.response.body.data.id}}
DELETE http://localhost:3000/api/usuario/{{id}}